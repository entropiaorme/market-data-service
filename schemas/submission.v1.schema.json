{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-data.entropiaorme.com/schemas/submission.v1.schema.json",
  "title": "Market observation submission (v1)",
  "description": "One client submission: a batch of per-item markup observations taken from the game's auction-house market ledger at one moment. Markup is null where the game reported N/A (no sales in that window); sales volume is normalised to PED. Compatibility policy: additive optional fields may join v1; anything else mints v2.",
  "type": "object",
  "required": ["schemaVersion", "observedAt", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the client took the readings (UTC)."
    },
    "clientVersion": {
      "type": "string",
      "maxLength": 32,
      "description": "The submitting app version, for schema-drift triage."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/itemObservation" }
    }
  },
  "$defs": {
    "itemObservation": {
      "type": "object",
      "required": ["itemName", "tier", "readings"],
      "additionalProperties": false,
      "properties": {
        "itemName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tier": { "type": "integer", "minimum": 0, "maximum": 10 },
        "readings": {
          "type": "object",
          "required": ["day", "week", "month", "year", "decade"],
          "additionalProperties": false,
          "properties": {
            "day": { "$ref": "#/$defs/reading" },
            "week": { "$ref": "#/$defs/reading" },
            "month": { "$ref": "#/$defs/reading" },
            "year": { "$ref": "#/$defs/reading" },
            "decade": { "$ref": "#/$defs/reading" }
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "required": ["markupPct", "salesPed"],
      "additionalProperties": false,
      "properties": {
        "markupPct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100000,
          "description": "Percentage of trade-terminal value; null where the game reported N/A."
        },
        "salesPed": { "type": "number", "minimum": 0 }
      }
    }
  }
}
